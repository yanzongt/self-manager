{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "vue": ["./node_modules/vue"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
